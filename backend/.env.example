# ResearchRabbit AI Backend Configuration — Environment Variables

# Database (PostgreSQL with SQLite fallback for local development)
DATABASE_URL=sqlite:///./researchrabbit.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/researchrabbit

# JWT Security
SECRET_KEY=research-rabbit-super-secret-jwt-signing-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Qdrant Vector Database
# Leave blank to use local embedded/in-memory Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=research_papers

# ==========================================
# Scholarly Data Providers
# ==========================================
# Default provider: "all" or "openalex" or "crossref" or "semantic_scholar" or "arxiv"
DEFAULT_SCHOLARLY_PROVIDER=all

# OpenAlex Polite Pool Email (faster rate limits & attribution)
OPENALEX_EMAIL=contact@researchrabbit.ai

# Crossref Polite Pool Email (Crossref REST API rate limit protection)
CROSSREF_EMAIL=contact@researchrabbit.ai

# Semantic Scholar API Key (optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# In-Memory Scholarly Cache TTL in seconds (default: 3600 = 1 hour)
SCHOLARLY_CACHE_TTL_SECONDS=3600

# ==========================================
# AI Model Providers (LLM & Embeddings)
# ==========================================
# LLM Provider: "builtin" (or "local"), "openai", "anthropic", "gemini"
LLM_PROVIDER=local

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embedding Provider: "local" (384d deterministic), "openai" (1536d), "gemini" (768d)
EMBEDDING_PROVIDER=local

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:5001","https://*.vercel.app"]
