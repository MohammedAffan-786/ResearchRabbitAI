# ==============================================================================
# ResearchRabbit AI — Global Environment Variables Reference (.env.example)
# Cost-optimized for Free-Tier Production & Local Development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vercel / Vite)
# ------------------------------------------------------------------------------
# In local development: leave unset to use Vite's built-in /api proxy
# In Vercel production: set to the live FastAPI backend origin (e.g. https://api.researchrabbit.ai)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Database Configuration (Relational PostgreSQL)
# ------------------------------------------------------------------------------
# Local Development (Zero cost, no external dependency required):
DATABASE_URL=sqlite:///./researchrabbit.db

# Managed PostgreSQL Free Tier Options:
# - Neon.tech (0.5 GiB free storage, autoscaling)
# - Supabase (500 MB free database)
# - Render (PostgreSQL free instance)
# Format: postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-cool-lake-1234.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant Semantic Embeddings)
# ------------------------------------------------------------------------------
# Local Development (Docker or in-memory fallback):
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=research_papers

# Managed Qdrant Cloud Free Tier Option:
# - Qdrant Cloud Free Forever Cluster (1 GB storage, ~100k 384d vectors)
# QDRANT_URL=https://<your-cluster-id>.us-east-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ------------------------------------------------------------------------------
# 4. JWT Authentication & Security
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-cryptographically-secure-random-64-character-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. Scholarly Metadata APIs (Free Polite Pools)
# ------------------------------------------------------------------------------
# Default search orchestrator target: "all", "openalex", "crossref", "semantic_scholar", "arxiv"
DEFAULT_SCHOLARLY_PROVIDER=all

# OpenAlex Polite Pool Email (elevates free rate limit to 10 req/s, CC0 license)
OPENALEX_EMAIL=researcher@university.edu

# Crossref Polite Pool Email (Crossref REST API rate limit protection)
CROSSREF_EMAIL=researcher@university.edu

# Semantic Scholar API Key (Optional; public rate limit applies without key)
SEMANTIC_SCHOLAR_API_KEY=

# In-Memory Cache TTL in seconds (default: 3600 = 1 hour)
SCHOLARLY_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 6. AI Engine — Ollama with Free Local Models (Primary Inference Engine)
# ------------------------------------------------------------------------------
# The entire platform uses Ollama as its primary AI inference engine with 100% free local models:
# - Generative Model: qwen3:4b (AI Research Assistant, Literature Reviews, Q&A, Gap Identification)
# - Embedding Model: nomic-embed-text (Dense Semantic Search, PDF Embeddings, Qdrant 768d Indexing)
# Run `ollama serve` and `ollama pull qwen3:4b` + `ollama pull nomic-embed-text` locally.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=120.0
OLLAMA_CONTEXT_WINDOW=4096

# Fallback & Zero-Dependency Testing Providers:
# LLM: "ollama" (primary), "builtin" (deterministic fallback)
# Embeddings: "ollama" (768d primary), "local" (384d deterministic fallback)

# Optional Commercial LLM Credentials (for testing provider abstractions only):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 7. Server, Worker & CORS Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.vercel.app"]
UPLOAD_DIR=backend/uploads
WORKER_POLL_INTERVAL=2.0
